# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=your-key-here
# OPENAI_API_KEY=your-key-here

LLM_PROVIDER=anthropic          # anthropic | openai
# LLM_MODEL=                    # defaults: claude-haiku-5-5 (anthropic), gpt-4o-mini (openai)

# Retrieval knobs (change one at a time, then re-run the evals)
# CHUNK_MAX_CHARS=600
# CHUNK_OVERLAP=100
# TOP_K=3
# MIN_SCORE=0.15

# Optional tracing with LangSmith (shows every node, prompt and tool call)
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=your-key-here
# LANGSMITH_PROJECT=carenest-agent
